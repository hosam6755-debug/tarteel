rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin');
    }

    // Video jobs collection
    match /videoJobs/{jobId} {
      // Allow user to create job with their own userId and read their own jobs
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.role == 'admin');
      allow update, delete: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Generations tracking collection
    match /generations/{genId} {
      allow read, write: if request.auth != null;
    }
  }
}

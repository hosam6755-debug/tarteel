rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /videos/{userId}/{allPaths=**} {
      // Allow user to read their own generated videos or public read
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin');
    }
  }
}
